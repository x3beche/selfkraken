# selfkraken configuration — copy to .env and edit.
# Real environment variables always win over this file.
# Never commit your real .env; it should be chmod 600 (install.sh does this).

# Where selfkraken.db and the sample repo live.
# Default: $XDG_DATA_HOME/selfkraken or ~/.local/share/selfkraken
#SK_DATA_DIR=~/.local/share/selfkraken

# ---------------------------------------------------------------------------
# Model (optional). Leave all of these commented out to run in degraded mode:
# every command works except model-generated proposals — you can still create
# proposals from a manual diff file (`skraken propose "..." --diff-file d.patch`).
# ---------------------------------------------------------------------------

# OpenAI-compatible base URL. The client POSTs to {base_url}/chat/completions.
# Example — local Ollama:
#SK_LLM_BASE_URL=http://localhost:11434/v1
# Example — any generic OpenAI-compatible endpoint:
#SK_LLM_BASE_URL=https://api.example.com/v1

# Optional bearer token. Only sent as `Authorization: Bearer ...` to the URL
# above. A key is not required for local servers like Ollama. It stays in this
# file / your environment — selfkraken never prints or logs it (shown only as
# "set"/"not set" by `skraken doctor`, and redacted from any output).
#SK_LLM_API_KEY=sk-...

# Model name sent in the request. Required together with SK_LLM_BASE_URL to
# enable the model; without both, selfkraken stays in degraded mode.
#SK_LLM_MODEL=qwen2.5-coder:7b

# Timeout (seconds) for each model request. Default: 120
#SK_LLM_TIMEOUT=120

# Maximum characters of repo context (request + indexed snippets) sent to the
# model in one request. Default: 12000
#SK_MAX_CONTEXT_CHARS=12000

# Timeout (seconds) per test run. Default: 600
#SK_TEST_TIMEOUT=600
